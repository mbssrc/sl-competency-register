{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.schema.json",
  "title": "Service",
  "description": "A service offered by the lab with required competencies",
  "type": "object",
  "required": ["id", "name", "description", "required_competencies"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SVC-[A-Z][A-Z0-9-]+$",
      "description": "Unique service identifier (e.g., SVC-HWSEC-EVAL)"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope_reference": {
      "type": "string",
      "description": "Accreditation scope reference (ISO 17025 style)"
    },
    "required_competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "minimum_level"],
        "additionalProperties": false,
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$",
            "description": "Skill ID reference"
          },
          "minimum_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      },
      "minItems": 1
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Applicable standards and methodologies"
    }
  }
}
