{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Domain Maturity Profile",
  "description": "A per-domain maturity ladder. Seniority is computed from aggregate skill breadth and depth within the domain; each level is evaluated independently and the highest level whose thresholds are met wins.",
  "type": "object",
  "required": ["id", "name", "domain", "description", "maturity_levels"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$",
      "description": "Unique profile identifier, conventionally the domain ID (e.g., HWSEC)"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+$",
      "description": "Domain ID from taxonomy/_meta.json"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "maturity_levels": {
      "type": "object",
      "required": ["junior", "practitioner", "senior", "lead", "principal"],
      "additionalProperties": false,
      "properties": {
        "junior": { "$ref": "#/$defs/level" },
        "practitioner": { "$ref": "#/$defs/level" },
        "senior": { "$ref": "#/$defs/level" },
        "lead": { "$ref": "#/$defs/level" },
        "principal": { "$ref": "#/$defs/level" }
      }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "required": ["title", "description", "thresholds"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain_skills_at": {
              "type": "object",
              "description": "Map of proficiency level to the minimum number of domain skills held at that level or higher",
              "propertyNames": { "pattern": "^[1-5]$" },
              "additionalProperties": { "type": "integer", "minimum": 1 }
            },
            "min_categories": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum number of distinct domain categories in which the person holds a skill"
            },
            "foundation_avg": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "Minimum average level across the person's Foundations skills"
            }
          }
        },
        "pinned": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "minimum_level"],
            "additionalProperties": false,
            "properties": {
              "skill": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9-]+$",
                "description": "Skill ID reference"
              },
              "minimum_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      }
    }
  }
}
